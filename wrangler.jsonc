{
  // Cloudflare Workers static-assets deploy for chesswithprince.com.
  // The connected Git build runs `npx wrangler deploy`, which reads this file.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "play-chess1",
  "compatibility_date": "2026-08-20",
  "workers_dev": true,
  "observability": { "enabled": true },

  // Serve the built React app (Vite output). `npm --prefix web run build`
  // writes the app + Stockfish engine + `_headers` into dist/, which is
  // committed so `npx wrangler deploy` publishes it with no CI build step.
  "assets": { "directory": "dist" },

  // Attach the custom domain. Because chesswithprince.com is already a zone in
  // this Cloudflare account, `custom_domain: true` provisions the DNS record and
  // TLS certificate for the subdomain on deploy — no dashboard step needed.
  "routes": [
    { "pattern": "play.chesswithprince.com", "custom_domain": true }
  ]
}
